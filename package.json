{
  "name": "cerberus",
  "version": "1.4.1",
  "description": "HAWKEYE Ground Control Station",
  "author": "hkl",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:portable": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win portable"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.hawkeyecs",
    "productName": "cerberus",
    "files": [
      "main.js",
      "public/**/*",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        "portable",
        "nsis",
        "icon": "public/assets/icon.ico"
      ]
    },
    "asar": true
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  }
}
