{
  "name": "cerberus",
  "version": "1.4.1",
  "description": "HAWKEYE Ground Control Station",
  "author": {
    "name": "Hawkeye Development Team",
    "email": "hawkeye1st@gmail.com"
  },
  "main": "main.js",

  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:linux": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --linux"
  },

  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0"
  },

  "dependencies": {
    "leaflet": "^1.9.4"
  },

  "build": {
    "appId": "com.hawkeyecs",
    "productName": "Hawkeye",

    "files": [
      "main.js",
      "public/**/*",
      "backend/**/*",
      "package.json",
      "assets/main-logo.png"
    ],

    "win": {
      "target": [
        "portable"
        "nsis"
      ],
      "icon": "public/assets/main-logo.ico"
    },

    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "assets/main-logo.png"
    },

    "directories": {
      "output": "dist"
    },

    "asar": true
  }
}